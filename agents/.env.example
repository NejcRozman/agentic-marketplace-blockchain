# Copy to agents/.env and fill in. The runner reads this file and passes the values
# to every agent process; everything else an agent needs is set per run by the runner.

# Accounts on the local chain. Any two fresh keys work (e.g. from `cast wallet new`);
# the runner funds them on the local chain, so they need no real balance.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONSUMER_PRIVATE_KEY=

# LLM calls, through OpenRouter. Required by conditions with an LLM agent and by the
# live mode. Conditions without one still need a non-empty value (any placeholder).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Live mode only: Pinata for pinning requests and results to IPFS (a JWT, or an API
# key and secret), and a dedicated Pinata gateway for reading them back.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
IPFS_GATEWAY=https://<your-gateway>.mypinata.cloud/ipfs/
PINATA_GATEWAY_TOKEN=

# Building the chain snapshot (experiments/chain/build_chain_snapshot.py) only:
# forks Sepolia once through Infura.
INFURA_API_KEY=
